# Required: Anthropic API key for the Claude Code agent inside the sandbox.
# Get one at https://console.anthropic.com/settings/keys
# Or use a Claude subscription via CLAUDE_CODE_OAUTH_TOKEN — see
# https://github.com/mattpocock/sandcastle/issues/191
ANTHROPIC_API_KEY=sk-ant-...

# Required: GitHub token the agent uses for `gh issue view`, branch ops, etc.
# Generate at https://github.com/settings/tokens
# Scope: `repo` (read issues, push branches). Use a fine-grained token scoped
# to Goldberry-Playground/grove-sites for least privilege.
GH_TOKEN=ghp_...
