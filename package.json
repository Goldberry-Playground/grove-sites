{
  "name": "grove-sites",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --ui=stream",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "clean": "turbo run clean",
    "build:design-bundles": "bash scripts/build-design-bundles.sh",
    "upload-asset": "pnpm --filter @grove/assets run ingest:products"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/ui": "^4.1.12",
    "happy-dom": "^20.9.0",
    "turbo": "^2.9.14",
    "typescript": "^5.7.0",
    "vite": "^8.3.5",
    "vitest": "^4.1.12"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0 <24.0.0",
    "pnpm": ">=9.15.0"
  },
  "pnpm": {
    "overrides": {
      "picomatch": "^4.0.4",
      "ws": "^8.21.0",
      "vite": "^8.3.5",
      "undici": "^7.29.1",
      "brace-expansion": "^5.0.11",
      "browserslist": "^4.28.7",
      "minimatch@3": "^10.2.5",
      "js-yaml@4": "^4.3.2",
      "nanoid": "^3.3.17",
      "sharp": "^0.35.5",
      "next": "^15.5.28",
      "postcss": "^8.5.18",
      "source-map-js": "^1.2.2",
      "sanitize-html": "^2.18.1",
      "uuid": "^13.0.1",
      "@humanfs/node": "^0.16.8",
      "fflate": "^0.8.3"
    }
  }
}
