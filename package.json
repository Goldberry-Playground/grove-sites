{
  "name": "grove-sites",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "turbo run dev --ui=stream",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "type-check": "turbo run type-check",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "clean": "turbo run clean",
    "build:design-bundles": "bash scripts/build-design-bundles.sh",
    "upload-asset": "pnpm --filter @grove/assets run ingest:products"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/ui": "^4.1.5",
    "happy-dom": "^20.9.0",
    "turbo": "^2.5.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22.0.0 <24.0.0",
    "pnpm": ">=9.15.0"
  },
  "pnpm": {
    "overrides": {
      "picomatch": "^4.0.4",
      "ws": "^8.21.0",
      "vite": "^8.0.16",
      "undici": "^7.28.0",
      "brace-expansion": "^5.0.8",
      "js-yaml@4": "^4.3.0",
      "sharp": "^0.35.0",
      "next": "^15.5.21",
      "postcss": "^8.5.18"
    }
  }
}
