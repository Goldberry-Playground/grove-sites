node_modules/
.next/
dist/
.env*.local
.turbo
*.tsbuildinfo
.vercel
.output

# Sandcastle agent runtime — never commit env file or local worktrees/logs.
.sandcastle/.env
.sandcastle/logs/
.sandcastle/worktrees/
.sandcastle/review-notes-*.md

# Local Claude Code agent config — not shared.
.claude/

# design-sync converter is a committed build tool; only its installed deps are ignored
.ds-sync/node_modules/
# Snapshots of the LIVE published bundle, fetched by the ds-guard preflight
# (GOL-402). Deliberately not committed: a snapshot is evidence about the far
# side at one moment, and a committed one would go stale and start vouching for
# pushes it can no longer speak for. The committed anchor is
# .design-sync/baseline.<brand>.json instead.
.ds-sync/published/
dist-bundles/
ds-bundle/
.design-sync/.cache/
apps/qa-portal/public/bundles/

# local render/QA scratch harnesses (see GOL-1081)
_render/

# Playwright E2E outputs (GOL-1074)
playwright-report/
test-results/
apps/*/e2e/.artifacts/

# Python bytecode (stray audit-script compile artifacts — GOL-1907)
__pycache__/
*.pyc
