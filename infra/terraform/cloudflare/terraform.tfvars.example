# Copy to terraform.tfvars and adjust. terraform.tfvars is .gitignored; these IDs
# are NOT secret (they're the storefront zone/account IDs), but env specifics stay
# out of the committed tree. The CF API token + monitoring secret come from
# 1Password via .env.op, NOT from this file.
#
# Values below are the REAL storefront inventory, confirmed 2026-07-11 via the CF
# API: 4 zones, all Free tier, one account. (The GOL-264 ticket's original
# atthegrove.com / georgeggg.com / woodworkinggeorge.com are NOT in this CF
# account — pending CEO confirmation of where they resolve.)

cloudflare_account_id = "5579f08c66e73a09ceb7855a19b14e11"

# All four zones are Free. This gates the module to the Free-tier subset:
# Bot Fight Mode + cookie-aware Cache Rules + the §4 allowlist folded into the
# existing "Grove edge policy" ruleset. Full Managed WAF + advanced rate limiting
# stay OFF until a zone is upgraded to Pro (per the accepted board decision to
# ship the Free subset now and defer the Pro upgrade).
plan_tier = "free"

# The 4 storefront zones. rollout_first marks the lowest-traffic zone that leads
# the Bot Fight Mode rollout (§6 — BFM has no log mode).
zones = {
  goldberry_farm = { domain = "goldberrygrove.farm", zone_id = "0c31404bc38c968a66b302bb99e9fad3" }
  nursery        = { domain = "atthegrovenursery.com", zone_id = "939fd63eb2cadd07d57aa193fd543764" }
  gathering      = { domain = "gatheringatthegrove.com", zone_id = "04ca33af08b2671402393a444da0e698" }
  woodworking    = { domain = "woodworkingeorge.com", zone_id = "ea21ae31a73f7098ba6f962f8f10561a", rollout_first = true }
}

# Rollout toggles — safe defaults live in variables.tf. On Free the WAF-managed
# and rate-limit tiers are gated off regardless; cache rules + the allowlist ship
# with the first apply, Bot Fight Mode advances last (woodworkingeorge.com first):
# cache_rules_enabled   = true
# custom_firewall_mode  = "on"     # allowlist + preserved CN/RU block
# enable_bot_management = false     # -> true starts BFM on woodworkingeorge.com only
