# browser-runtime: commit the SCRIPTS, never the heavy build artifacts.
# Everything below is regenerated by `bash bootstrap.sh` (idempotent). See README.md.
#
# Chromium browser binaries (~646M) — Playwright download
ms-playwright/
# Extracted Debian system libs (~294M) — dpkg -x output
libs/
# trixie Packages/Contents indexes (~215M) — deletable after build
idx/
# Downloaded .deb files (transient)
debs/
# npm install of the playwright package (regenerated)
node_modules/
package-lock.json
# npm cache + scratch
.npm/
tmp/
pw/
# smoke-test / build logs and generated screenshots
*.log
smoke-*.png
