# Where each vendor's grove_headless API lives. V0: all three sister sites share one Odoo.
GROVE_ODOO_URL=http://localhost:8069

# Ghost — village journal. One shared instance for the hub's editorial content.
HUB_GHOST_URL=http://localhost:2368
HUB_GHOST_CONTENT_API_KEY=replace_with_real_key

# Shared secret for /api/revalidate. Generate with: openssl rand -hex 32
GROVE_REVALIDATE_SECRET=replace_with_random_hex

# ── RUM / analytics (@grove/analytics dual-writer) ───────────────────────
# Master switch. OFF in local dev; set true in QA/prod where the OpenObserve
# RUM + self-hosted Plausible endpoints exist. Do-Not-Track is always honored.
NEXT_PUBLIC_RUM_ENABLED=false
NEXT_PUBLIC_RUM_ENV=local

# OpenObserve RUM sink. Enabled only when SITE + CLIENT_TOKEN are both set.
# CLIENT_TOKEN: OpenObserve → Ingestion → RUM. SITE is host:port, no scheme.
NEXT_PUBLIC_OO_RUM_SITE=oo.qa-l3.gatheringatthegrove.com
NEXT_PUBLIC_OO_RUM_CLIENT_TOKEN=
NEXT_PUBLIC_OO_RUM_APP_ID=grove-hub
NEXT_PUBLIC_OO_RUM_SERVICE=grove-hub
NEXT_PUBLIC_OO_RUM_ORG=default
# true only if OpenObserve is served over plain HTTP (e.g. local); else false.
NEXT_PUBLIC_OO_RUM_INSECURE=false

# Plausible sink (self-hosted). Enabled only when HOST + DOMAIN are both set.
# HOST is the Plausible instance URL; DOMAIN is the site key registered in it.
NEXT_PUBLIC_PLAUSIBLE_HOST=https://plausible.gatheringatthegrove.com
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=gatheringatthegrove.com
