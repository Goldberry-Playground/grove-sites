# At The Grove Nursery storefront — local dev env file.
# Copy to .env.local and fill in values. Do NOT commit .env.local.

# ── Odoo backend ─────────────────────────────────────────────────────────
# Sent as the X-Grove-Tenant header — controls multi-tenant company scoping
# in grove_headless. Must match the website name configured in Odoo (see
# grove_headless/data/grove_companies.xml).
TENANT_ID=nursery

# Same value, exposed to the client bundle. Used by cart-store to scope the
# localStorage key per tenant — prevents goldberry/ggg/nursery carts from
# bleeding into each other when sites share a domain or a developer is
# testing more than one locally.
NEXT_PUBLIC_TENANT_ID=nursery

# Local: http://localhost:8069 (from `make stack-up`)
# Sandbox/prod: set to the deployed Odoo URL.
ODOO_URL=http://localhost:8069

# Optional. Leave blank for the public storefront endpoints (products, cart,
# orders) — they use auth=public and don't need a key.
ODOO_API_KEY=

# ── Ghost CMS ────────────────────────────────────────────────────────────
# Nursery's Ghost runs on port 2370 locally (Goldberry is 2368, GGG is 2369).
GHOST_URL=http://localhost:2370

# Generate via `make ghost-setup-nursery` (requires GHOST_ADMIN_PASSWORD env).
# That script creates a Custom Integration in Ghost and prints the key.
GHOST_CONTENT_KEY=
