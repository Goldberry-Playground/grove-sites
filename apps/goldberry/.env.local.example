# Goldberry storefront — local dev env file.
# Copy to .env.local and fill in values. Do NOT commit .env.local.

# ── Odoo backend ─────────────────────────────────────────────────────────
# Sent as the X-Grove-Tenant header — controls multi-tenant company scoping
# in grove_headless. Must match the website name configured in Odoo (see
# grove_headless/data/grove_companies.xml).
TENANT_ID=goldberry

# Same value, exposed to the client bundle. Used by cart-store to scope the
# localStorage key per tenant — prevents goldberry/ggg/nursery carts from
# bleeding into each other when sites share a domain or a developer is
# testing more than one locally.
NEXT_PUBLIC_TENANT_ID=goldberry

# Local: http://localhost:8069 (from `make stack-up`)
# Sandbox/prod: set to the deployed Odoo URL.
ODOO_URL=http://localhost:8069

# Optional. Leave blank for the public storefront endpoints (products, cart,
# orders) — they use auth=public and don't need a key. Set to a real key if
# you wire up authenticated endpoints later.
ODOO_API_KEY=

# ── Ghost CMS ────────────────────────────────────────────────────────────
# Local: http://localhost:2368
# Sandbox/prod: set to the deployed Ghost URL.
GHOST_URL=http://localhost:2368

# Generate via `make ghost-setup-goldberry` (requires GHOST_ADMIN_PASSWORD env).
# That script creates a Custom Integration in Ghost and prints the key.
# Without it the /blog page will return 401 from Ghost.
GHOST_CONTENT_KEY=

# ── RUM / analytics (@grove/analytics dual-writer) ───────────────────────
# Master switch. OFF in local dev; set true in QA/prod where the OpenObserve
# RUM + self-hosted Plausible endpoints exist. Do-Not-Track is always honored.
NEXT_PUBLIC_RUM_ENABLED=false
NEXT_PUBLIC_RUM_ENV=local

# OpenObserve RUM sink. Enabled only when SITE + CLIENT_TOKEN are both set.
# CLIENT_TOKEN: RUM ingest token (browser-public, RUM-ingest-only).
#   op://Goldberry Grove - Admin/Grove Infra/obs_rum_client_token
# SITE is the browser-reachable grove-obs RUM host, no scheme (GOL-311).
NEXT_PUBLIC_OO_RUM_SITE=rum.gatheringatthegrove.com
NEXT_PUBLIC_OO_RUM_CLIENT_TOKEN=
NEXT_PUBLIC_OO_RUM_APP_ID=grove-goldberry
NEXT_PUBLIC_OO_RUM_SERVICE=grove-goldberry
NEXT_PUBLIC_OO_RUM_ORG=default
# true only if OpenObserve is served over plain HTTP (e.g. local); else false.
NEXT_PUBLIC_OO_RUM_INSECURE=false

# Plausible sink (self-hosted). Enabled only when HOST + DOMAIN are both set.
# HOST is the Plausible instance URL; DOMAIN is the site key registered in it.
NEXT_PUBLIC_PLAUSIBLE_HOST=https://plausible.gatheringatthegrove.com
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=goldberrygrove.farm

# ── Server-side OpenTelemetry tracing (@grove/otel) ──────────────────────
# OFF in local dev (endpoint blank → no-op). In QA/prod, this app's server spans
# + auto-instrumented BFF→Odoo/Ghost fetch spans export to OpenObserve over OTLP
# and correlate with Beyla's Odoo RED spans. SERVER-side only (never
# NEXT_PUBLIC_*) — the OpenObserve basic-auth header must not reach the browser.
OTEL_SERVICE_NAME=grove-goldberry
# QA/prod, e.g. https://oo.qa-l3.gatheringatthegrove.com/api/default/v1/traces
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
# Authorization=Basic <base64(OPENOBSERVE_ROOT_EMAIL:OPENOBSERVE_ROOT_PASSWORD)>
OTEL_EXPORTER_OTLP_HEADERS=
